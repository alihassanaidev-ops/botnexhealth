# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info
.eggs
dist
build
.venv
venv
ENV

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Testing
.pytest_cache
.coverage
htmlcov
.tox
.nox

# Documentation (not needed in container)
docs/
*.md
!README.md

# Development files
*.log
*.tmp
.env.local
.env.development
.env.test

# Frontend is published separately to S3/CloudFront. It is not used by the
# backend Dockerfile, and including its dependency tree can exhaust the CDK
# staging volume before Docker even starts.
nexus-dashboard-web/

# Scripts not needed in production
scripts/
test_*.sh

# Tests (optional - exclude for smaller image)
tests/

# Docker files (prevent recursive copy)
Dockerfile*
docker-compose*.yml
.docker/

# Misc
.DS_Store
Thumbs.db

# Secrets (never include in images)
secrets/
.env
*-secrets.txt

# Local QA tooling
twilio_browser_phone/

# Agent files
.gemini/

# Render config (not needed in image)
render.yaml

# Infrastructure (CDK, Copilot)
infra/
copilot/
